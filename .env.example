# Supabase project credentials.
# Project Settings > API Keys in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# "false" puts the app on the live Supabase project. Any other value (or
# unset) keeps every screen on the in-memory mock store, which needs no
# credentials.
#
# Going live does not put every domain on Supabase: the project's schema only
# backs some of them today. `BACKENDS` in apis/config.ts records which, and
# apis/migrations/001_app_gap.sql is the SQL that closes the rest of the gap.
EXPO_PUBLIC_USE_MOCK_DATA=false
