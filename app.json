{
  "expo": {
    "name": "AutoPilot",
    "slug": "autopilot-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "autopilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nova.autopilotapp",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "AutoPilot uses Face ID so you can sign in without typing your password.",
        "NSPhotoLibraryUsageDescription": "AutoPilot needs access to your photos so you can attach documents such as your insurance or licence."
      }
    },
    "android": {
      "package": "com.nova.autopilot",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#EC5B13"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/auto-pilot.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/auto-pilot.png",
            "backgroundColor": "#0B0F14"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "AutoPilot uses Face ID so you can sign in without typing your password."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "00241241-5661-4061-b57e-1038d30990b6"
      }
    }
  }
}
